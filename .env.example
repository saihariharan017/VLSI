# Required: create a Gemini API key and put it here.
GEMINI_API_KEY=your_gemini_api_key_here

# Flask signs the temporary session cookie. Use a long random value in production.
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# Render supplies PORT automatically. Leave this at 10000 for local development.
PORT=10000

# Keep false locally if using http://127.0.0.1. Set true on HTTPS production deployments.
COOKIE_SECURE=false

# Optional configuration overrides.
SESSION_FILE_DIR=/tmp/vlsi_assistant_sessions
CHATBOT_TITLE=VLSI ASSISTANT
CHATBOT_DOMAIN=Very-Large-Scale Integration (VLSI) design and EDA
CHATBOT_TAGLINE=Silicon design, explained with engineering clarity.
GEMINI_MODEL=gemini-3.1-flash-lite
MAX_HISTORY_MESSAGES=20
MAX_MESSAGE_CHARS=4000
RATE_LIMIT_PER_MINUTE=20
